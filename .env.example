# ============================================================
# Enterprise Observability Pipeline — Environment Configuration
# ============================================================
# Copy this file to .env and customize for your environment.

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW=metrics.raw
KAFKA_TOPIC_PROCESSED=metrics.processed
KAFKA_TOPIC_ALERTS=alerts.fired
KAFKA_TOPIC_DLQ=metrics.dlq
KAFKA_CONSUMER_GROUP=processor-group

# ---- Go Ingestor ----
INGESTOR_PORT=8080
INGESTOR_LOG_LEVEL=info
INGESTOR_BATCH_SIZE=500
INGESTOR_FLUSH_INTERVAL_MS=100
INGESTOR_RATE_LIMIT_RPS=10000

# ---- Rust Processor ----
PROCESSOR_METRICS_PORT=9091
PROCESSOR_BATCH_SIZE=1000
PROCESSOR_FLUSH_INTERVAL_MS=500
PROCESSOR_EWMA_ALPHA=0.3
PROCESSOR_ZSCORE_WINDOW=300
PROCESSOR_ANOMALY_THRESHOLD=3.0

# ---- ClickHouse ----
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=observability
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ---- Prometheus ----
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# ---- Grafana ----
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- AlertManager ----
ALERTMANAGER_PORT=9093
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#observability-alerts
