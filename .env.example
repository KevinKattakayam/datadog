# ============================================================
# Enterprise Observability Pipeline — Environment Configuration
# ============================================================
# Copy to .env and fill in secrets before running:
#   cp .env.example .env

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW=metrics.raw
KAFKA_TOPIC_PROCESSED=metrics.processed
KAFKA_TOPIC_ALERTS=alerts.fired
KAFKA_TOPIC_DLQ=metrics.dlq
KAFKA_CONSUMER_GROUP=processor-group

# ── Go Ingestor ───────────────────────────────────────────────
INGESTOR_PORT=8080
INGESTOR_GRPC_PORT=50051
INGESTOR_LOG_LEVEL=info
INGESTOR_BATCH_SIZE=500
INGESTOR_FLUSH_INTERVAL_MS=100
INGESTOR_RATE_LIMIT_RPS=10000
# Default per-tenant rate limit (override per tenant via config)
INGESTOR_TENANT_DEFAULT_RPS=1000

# ── Rust Processor ────────────────────────────────────────────
PROCESSOR_METRICS_PORT=9091
PROCESSOR_BATCH_SIZE=1000
PROCESSOR_FLUSH_INTERVAL_MS=500
PROCESSOR_EWMA_ALPHA=0.3
PROCESSOR_ZSCORE_WINDOW=300
PROCESSOR_ANOMALY_THRESHOLD=3.0
# Circuit breaker: trips after N consecutive ClickHouse failures
PROCESSOR_CB_FAILURE_THRESHOLD=5
PROCESSOR_CB_BASE_BACKOFF_MS=1000
PROCESSOR_CB_MAX_BACKOFF_MS=60000

# ── ClickHouse ────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=observability
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Redis (Cache Layer) ───────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL_MINUTES=5

# ── Schema Registry ───────────────────────────────────────────
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ── Prometheus ────────────────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Tracing (Tempo / Jaeger) ──────────────────────────────────
TEMPO_ENDPOINT=http://tempo:4317
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
OTEL_SERVICE_NAME=observability-pipeline

# ── AlertManager ─────────────────────────────────────────────
ALERTMANAGER_PORT=9093
SLACK_CHANNEL=#observability-alerts
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ── PagerDuty ─────────────────────────────────────────────────
# Get from: PagerDuty → Services → Integrations → Events API v2
PAGERDUTY_ROUTING_KEY=

# ── Terraform / AWS (for EKS deployment) ──────────────────────
AWS_REGION=us-east-1
TF_STATE_BUCKET=observability-pipeline-tfstate
TF_STATE_LOCK_TABLE=observability-pipeline-tflock
