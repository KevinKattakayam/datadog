<!-- Expose ClickHouse's own metrics for Prometheus on :9363/metrics.
     Port 8123 is the query interface and has no /metrics endpoint. -->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <errors>true</errors>
    </prometheus>
</clickhouse>
