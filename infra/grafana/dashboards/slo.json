{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "title": "SLO: Ingestor Availability (Target: 99.9%)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green", "value": 0.999 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 201,
      "title": "Current Availability (30d)",
      "type": "gauge",
      "targets": [
        {
          "expr": "1 - (sum(rate(ingestor_requests_total{status_code=~\"5..\"}[30d])) / sum(rate(ingestor_requests_total[30d])))",
          "legendFormat": "Availability"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.75 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 202,
      "title": "Error Budget Remaining",
      "type": "gauge",
      "targets": [
        {
          "expr": "1 - (sum(rate(ingestor_requests_total{status_code=~\"5..\"}[30d])) / sum(rate(ingestor_requests_total[30d]))) / 0.001",
          "legendFormat": "Budget"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit" }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "id": 203,
      "title": "Error Rate Over Time",
      "type": "timeseries",
      "targets": [
        { "expr": "slo:ingestor_requests:error_rate_5m", "legendFormat": "5m window" },
        { "expr": "slo:ingestor_requests:error_rate_1h", "legendFormat": "1h window" },
        { "expr": "slo:ingestor_requests:error_rate_6h", "legendFormat": "6h window" },
        { "expr": "vector(0.001)", "legendFormat": "SLO Target (0.1%)" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 210,
      "title": "Burn Rate Analysis",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 14.4 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 211,
      "title": "Fast Burn Rate (5m / 1h windows)",
      "type": "timeseries",
      "targets": [
        { "expr": "slo:ingestor_requests:error_rate_5m / 0.001", "legendFormat": "5m burn rate" },
        { "expr": "slo:ingestor_requests:error_rate_1h / 0.001", "legendFormat": "1h burn rate" },
        { "expr": "vector(14.4)", "legendFormat": "Fast burn threshold (14.4x)" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 212,
      "title": "Slow Burn Rate (6h window)",
      "type": "timeseries",
      "targets": [
        { "expr": "slo:ingestor_requests:error_rate_6h / 0.001", "legendFormat": "6h burn rate" },
        { "expr": "vector(3)", "legendFormat": "Slow burn threshold (3x)" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 220,
      "title": "SLO: Latency (Target: 99% < 200ms)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "id": 221,
      "title": "Request Latency Percentiles",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(ingestor_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.90, sum(rate(ingestor_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.95, sum(rate(ingestor_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(ingestor_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" },
        { "expr": "vector(0.2)", "legendFormat": "SLO Target (200ms)" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["slo", "error-budget", "observability"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SLO Dashboard — Error Budget",
  "uid": "obs-slo-dashboard",
  "version": 1
}
