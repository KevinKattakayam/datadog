{
  "type": "record",
  "name": "Alert",
  "namespace": "com.observability.pipeline",
  "doc": "Schema for anomaly alert events emitted by the processor",
  "fields": [
    {
      "name": "metric_name",
      "type": "string",
      "doc": "Name of the metric that triggered the alert"
    },
    {
      "name": "value",
      "type": "double",
      "doc": "The anomalous metric value"
    },
    {
      "name": "anomaly_score",
      "type": "double",
      "doc": "Computed anomaly score (Z-score or EWMA deviation)"
    },
    {
      "name": "threshold",
      "type": "double",
      "doc": "Threshold that was exceeded"
    },
    {
      "name": "detector",
      "type": {
        "type": "enum",
        "name": "DetectorType",
        "symbols": ["EWMA", "ZSCORE"]
      },
      "doc": "Which anomaly detection algorithm triggered"
    },
    {
      "name": "severity",
      "type": {
        "type": "enum",
        "name": "Severity",
        "symbols": ["WARNING", "CRITICAL"]
      },
      "doc": "Alert severity level"
    },
    {
      "name": "host",
      "type": "string",
      "doc": "Host where the anomaly was detected"
    },
    {
      "name": "timestamp",
      "type": "long",
      "doc": "Unix epoch seconds when the anomaly was detected"
    },
    {
      "name": "tags",
      "type": {
        "type": "map",
        "values": "string"
      },
      "doc": "Metric tags for context"
    }
  ]
}
